// Добавляет уведомление для телеграм-бота в справочник BKM_УведомленияТелеграмБоту.
// При успешной записи возвращает ссылку на созданный элемент.
// При ошибке возвращает Неопределено и записывает сообщение об ошибке
// в журнал регистрации.
//
// Параметры:
//   ТекстСообщения - Строка - текст уведомления для отправки в телеграм-бот.
//
// Возвращаемое значение:
//   СправочникСсылка.ВКМ_УведомленияТелеграмБоту, Неопределено - 
//       ссылка на созданный элемент или Неопределено при ошибке записи.
//
Функция ДобавитьУведомление(ТекстСообщения) Экспорт
    
    НовоеУведомление = СоздатьЭлемент();
    НовоеУведомление.ТекстСообщения = ТекстСообщения; 
    
    Попытка 
        НовоеУведомление.Записать(); 
    Исключение
        
        ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
            "Справочник.BKM_УведомленияТелеграмБоту.ДобавитьУведомление",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            ТекстОшибки);
        
        Возврат Неопределено;
        
    КонецПопытки;
    
    Возврат НовоеУведомление.Ссылка;
    
КонецФункции

#КонецОбласти

