#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ГрафикУжеСуществует() Тогда
		ТекстСообщения = СтрШаблон(
			"Запись невозможна. На %1 год график уже существует.",
			Формат(Год, "ЧГ=0"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Год", , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Собираем уникальных сотрудников и их суммарную продолжительность отпуска.
	// В каждой строке ТЧ лежит ОДНА И ТА ЖЕ общая сумма по сотруднику
	// (она вычисляется при изменении ТЧ для подсветки >28), 
	// поэтому берём первое значение для каждого сотрудника.
	СуммыПоСотрудникам = Новый Соответствие;
	
	Для Каждого СтрокаТЧ Из ОтпускаСотрудников Цикл
		
		Если СуммыПоСотрудникам[СтрокаТЧ.Сотрудник] = Неопределено Тогда
			СуммыПоСотрудникам.Вставить(
				СтрокаТЧ.Сотрудник, 
				СтрокаТЧ.ОбщаяПродолжительностьОтпуска);
		КонецЕсли;
		
	КонецЦикла;
	
	// Готовим таблицу для блокировки и проведения
	ДанныеОтпусков = Новый ТаблицаЗначений;
	ДанныеОтпусков.Колонки.Добавить(
		"Сотрудник", 
		Новый ОписаниеТипов("СправочникСсылка.ВКМ_Сотрудники"));
	ДанныеОтпусков.Колонки.Добавить(
		"ОбщаяПродолжительностьОтпуска", 
		Новый ОписаниеТипов("Число"));
	
	Для Каждого КлючИЗначение Из СуммыПоСотрудникам Цикл
		Строка = ДанныеОтпусков.Добавить();
		Строка.Сотрудник = КлючИЗначение.Ключ;
		Строка.ОбщаяПродолжительностьОтпуска = КлючИЗначение.Значение;
	КонецЦикла;
	
	// Заблокировать регистр сведений об отпусках по сотрудникам документа
	Если НЕ ЗаблокироватьРегистрСведенийОбОтпусках(ДанныеОтпусков, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// Сформировать движения
	Движения.ВКМ_СведенияОбОтпусках.Записывать = Истина;
	
	Для Каждого СтрокаОтпуска Из ДанныеОтпусков Цикл
		
		Движение = Движения.ВКМ_СведенияОбОтпусках.Добавить();
		Движение.Период = Дата;
		Движение.Сотрудник = СтрокаОтпуска.Сотрудник;
		Движение.Год = Год;
		Движение.ПлановаяПродолжительностьОтпуска = 
			СтрокаОтпуска.ОбщаяПродолжительностьОтпуска;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, существует ли уже документ ГрафикОтпусков на этот же год.
// Исключает сам текущий документ из проверки.
//
// Возвращаемое значение:
//   Булево - Истина, если график на этот год уже существует.
//
Функция ГрафикУжеСуществует()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВКМ_ГрафикОтпусков.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВКМ_ГрафикОтпусков КАК ВКМ_ГрафикОтпусков
		|ГДЕ
		|	ВКМ_ГрафикОтпусков.Год = &Год
		|	И ВКМ_ГрафикОтпусков.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Год", Год);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Блокирует регистр сведений об отпусках по сотрудникам документа,
// чтобы исключить параллельную запись из другого сеанса.
//
// Параметры:
//   ДанныеОтпусков - ТаблицаЗначений - свернутая по сотрудникам ТЧ.
//   Отказ - Булево - (входной/выходной) признак отказа проведения.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка установлена.
//
Функция ЗаблокироватьРегистрСведенийОбОтпусках(ДанныеОтпусков, Отказ)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
		"РегистрСведений.ВКМ_СведенияОбОтпусках");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для Каждого СтрокаОтпуска Из ДанныеОтпусков Цикл
		ЭлементБлокировки.УстановитьЗначение(
			"Сотрудник", СтрокаОтпуска.Сотрудник);
	КонецЦикла;
	
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(
			ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(
			"Не удалось заблокировать данные для расчета. Документ не проведён.
			|Подробности: " + ТекстОшибки, , , , Отказ);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#КонецЕсли